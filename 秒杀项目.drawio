        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% 定义节点样式 (模仿 draw.io 风格)\n    classDef default fill:#ffffff,stroke:#333333,stroke-width:2px,color:#333333,font-size:14px;\n    classDef error fill:#ffffff,stroke:#e53935,stroke-width:2px,color:#e53935,font-size:14px;\n    classDef success fill:#e8f5e9,stroke:#43a047,stroke-width:2px,color:#333333,font-size:14px;\n    classDef title fill:none,stroke:none,font-size:20px,font-weight:bold,color:#333333;\n\n    Title[\&quot;用户登录流程图\&quot;]:::title\n    Title ~~~ Start\n\n    Start[\&quot;用户提交登录请求&lt;br/&gt;(手机号 + 密码/验证码)\&quot;]\n    Step1[\&quot;1. 校验手机号格式\&quot;]\n    Step2[\&quot;2. 根据手机号查用户\&quot;]\n    Step3[\&quot;3. 判断登录类型&lt;br/&gt;type=1: 密码登录&lt;br/&gt;type=2: 验证码登录\&quot;]\n    Step4[\&quot;4. 校验用户状态\&quot;]\n    Step5[\&quot;5. 调用 SaToken&lt;br/&gt;StpUtil.login(userId)&lt;br/&gt;生成 Token\&quot;]\n    End[\&quot;6. 返回 Token + 用户基本信息\&quot;]:::success\n    \n    Err1[\&quot;返回参数错误\&quot;]:::error\n    Err2[\&quot;手机号未注册\&quot;]:::error\n    Err3[\&quot;返回密码错误\&quot;]:::error\n    Err4[\&quot;返回验证码错误\&quot;]:::error\n    Err5[\&quot;返回&#39;账号已被禁用&#39;\&quot;]:::error\n    \n    Start --&gt;|通过| Step1\n    Step1 --&gt;|不通过| Err1\n    Step1 --&gt;|存在| Step2\n    Step2 --&gt;|不存在| Err2\n    Step2 --&gt; Step3\n    Step3 --&gt;|密码错误| Err3\n    Step3 --&gt;|验证码错误| Err4\n    Step3 --&gt;|验证通过| Step4\n    Step4 --&gt;|已禁用| Err5\n    Step4 --&gt;|状态正常| Step5\n    Step5 --&gt; End&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="xg82J_ipwjnnh56Ttw2E-12">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
